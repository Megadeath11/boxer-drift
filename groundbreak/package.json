{
  "name": "groundbreak",
  "productName": "Groundbreak",
  "version": "1.0.0",
  "description": "Realistic earthmoving simulator: excavator, dump truck and dozer on deformable soil",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node serve.js",
    "package:win": "electron-packager . Groundbreak --platform=win32 --arch=x64 --out=dist --overwrite --ignore=^/dist --ignore=^/serve.js",
    "package:mac": "electron-packager . Groundbreak --platform=darwin --arch=arm64,x64 --out=dist --overwrite --ignore=^/dist",
    "package:linux": "electron-packager . Groundbreak --platform=linux --arch=x64 --out=dist --overwrite --ignore=^/dist"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "@electron/packager": "18.3.6"
  }
}
